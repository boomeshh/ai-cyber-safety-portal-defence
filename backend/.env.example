# Rakshak AI — Environment Configuration
# Copy this file to .env and fill in your values

# ── AES-256-GCM encryption (required in production) ──────────────────────
# Use a random 64-character hex value or base64-encoded 32-byte key.
RAKSHAK_AES_KEY=replace_with_64_hex_characters
# SECRET_KEY is an accepted HKDF fallback when RAKSHAK_AES_KEY is unset.
SECRET_KEY=replace_with_a_long_random_secret
RAKSHAK_ENV=production

# ── Firebase Admin credentials (required for /complaints/firebase) ─────────
# Preferred for Render: paste the complete service-account JSON as one secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative: an absolute/accessible path to a downloaded credentials file.
GOOGLE_APPLICATION_CREDENTIALS=
RAKSHAK_TESTING=0

# ── Resend email alerts (recommended — works on Render free plan) ──────────
RESEND_ENABLED=false
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Rakshak AI <alerts@yourdomain.com>
RESEND_ALERT_TO=admin@example.com,cert@example.com

# ── SMTP email alerts (fallback — may fail on Render free plan) ───────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_TO=admin@rakshak.ai,cert@rakshak.ai

# ── VirusTotal URL threat intelligence (optional) ─────────────────────────
VT_ENABLED=false
VT_API_KEY=your-virustotal-api-key
